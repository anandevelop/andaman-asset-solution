# ═══════════════════════════════════════════════════════════════════════
#  ANDAMAN ASSET SOLUTION — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
#
#  Copy to .env for local development, or load into your host's secret
#  store for production. Never commit the filled-in file.
#
#  Each variable is marked:
#    [required]  the app will not start or a core feature is broken
#    [optional]  the feature disables itself cleanly when unset
#    [not wired] declared for a planned integration; nothing reads it yet
#
#  NEXT_PUBLIC_* values are inlined into the browser bundle AT BUILD TIME.
#  Changing one requires a rebuild, not just a restart — and never put a
#  secret behind that prefix.
#
#  See docs/DEPLOYMENT.md for the deploy sequence and
#  docs/LAUNCH_CHECKLIST.md for what must be real before going live.
# ═══════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────
#  1. DATABASE                                                [required]
# ───────────────────────────────────────────────────────────────────────

# Read by docker-compose.yml when running Postgres locally. Ignored in
# production, where the database is managed elsewhere.
POSTGRES_USER=andaman_admin
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=andaman_asset_solution

# The only one the application itself reads.
# Production: add ?sslmode=require and use a pooled connection string if
# your host puts PgBouncer in front.
DATABASE_URL="postgresql://andaman_admin:changeme_local_only@localhost:5432/andaman_asset_solution?schema=public"


# ───────────────────────────────────────────────────────────────────────
#  2. AUTHENTICATION                                          [required]
# ───────────────────────────────────────────────────────────────────────

# Must be the exact public origin — scheme, host, no trailing slash.
# A mismatch breaks the sign-in callback with no useful error.
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
# Rotating this invalidates every active session immediately.
NEXTAUTH_SECRET="replace_with_generated_secret"


# ───────────────────────────────────────────────────────────────────────
#  3. BOOTSTRAP ADMIN                                         [optional]
# ───────────────────────────────────────────────────────────────────────
#
# Read only by `npm run admin:create`, which seeds the first back-office
# login. After that, accounts are managed at /admin/users.
#
# Flags override these:
#   npm run admin:create -- --email you@example.com --name "Your Name"
#
# Leave ADMIN_PASSWORD empty and the script generates one and prints it
# once. Do not commit a real password here.

ADMIN_EMAIL="admin@andamanassetsolution.com"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=""
ADMIN_ROLE="SUPER_ADMIN"


# ───────────────────────────────────────────────────────────────────────
#  4. IMAGE STORAGE — AWS S3 + CloudFront                     [required]
# ───────────────────────────────────────────────────────────────────────
#
# Uploads go browser → S3 directly via a presigned URL; the server never
# handles file bytes. The IAM user needs s3:PutObject on this bucket and
# nothing else.
#
# Without these, the admin image uploader returns a clear
# "not configured" message and the rest of the site works normally.

AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="replace_with_access_key_id"
AWS_SECRET_ACCESS_KEY="replace_with_secret_access_key"
AWS_S3_BUCKET_NAME="andaman-asset-solution-media"

# Public reads go through CloudFront, never the bucket URL: the bucket
# stays private behind an Origin Access Control, and the domain stored in
# the database survives a bucket rename or region move.
#
# Host only — no scheme, no trailing slash. Also added to
# next.config.js images.remotePatterns, so changing it needs a rebuild.
NEXT_PUBLIC_CLOUDFRONT_DOMAIN="d111111abcdef8.cloudfront.net"


# ───────────────────────────────────────────────────────────────────────
#  5. LINE OFFICIAL ACCOUNT                                   [optional]
# ───────────────────────────────────────────────────────────────────────

# From the LINE Developers console → Messaging API channel.
LINE_CHANNEL_SECRET="replace_with_line_channel_secret"
LINE_CHANNEL_ACCESS_TOKEN="replace_with_line_channel_access_token"

# Who receives new-lead and new-RSVP pushes. LINE user IDs (U…) or a
# group ID (C…), comma separated.
#
# To find yours: set the webhook to https://your-domain/api/line/webhook,
# message the OA once, and read the ID from the server logs.
# Leave blank to disable LINE notifications entirely.
LINE_NOTIFY_TO=""

# Public "add friend" link shown in the footer and on /contact.
LINE_OA_ID="@andamanasset"
NEXT_PUBLIC_LINE_ADD_FRIEND_URL="https://line.me/R/ti/p/@andamanasset"


# ───────────────────────────────────────────────────────────────────────
#  6. SPAM PROTECTION — reCAPTCHA v3                          [optional]
# ───────────────────────────────────────────────────────────────────────
#
# Both keys must be set for verification to run. With either missing,
# forms still submit and the skip is logged — losing real enquiries to a
# misconfiguration is worse than the spam it would have caught.
#
# The same applies at runtime: if Google is unreachable the submission is
# allowed through. Only a genuine low score or a forged token is rejected.

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Scores below this are rejected. 0.5 is Google's default; raise toward
# 0.7 if spam gets through, lower if real submissions are being blocked.
RECAPTCHA_MIN_SCORE="0.5"


# ───────────────────────────────────────────────────────────────────────
#  7. ANALYTICS                                               [optional]
# ───────────────────────────────────────────────────────────────────────
#
# Left blank, no script is injected at all — which is what keeps local
# development free of tracking requests.
#
# NEXT_PUBLIC_META_PIXEL_ID and GOOGLE_SITE_VERIFICATION are only the
# deploy-time defaults. Both can also be set from Admin → Settings →
# "Analytics & SEO" without a rebuild — that value wins when present. GA4
# stays env-only; there is no admin field for it.

NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
# The content="..." value of Google's HTML-tag verification meta tag.
GOOGLE_SITE_VERIFICATION=""


# ───────────────────────────────────────────────────────────────────────
#  8. SITE                                                    [required]
# ───────────────────────────────────────────────────────────────────────

# Canonical origin. Used for canonical URLs, hreflang, sitemap, robots
# and JSON-LD — a wrong value here quietly corrupts every one of them.
NEXT_PUBLIC_SITE_URL="https://andamanassetsolution.com"

NEXT_PUBLIC_DEFAULT_LOCALE="th"


# ───────────────────────────────────────────────────────────────────────
#  9. ERROR MONITORING — Sentry                               [optional]
# ───────────────────────────────────────────────────────────────────────
#
# Exceptions only: no performance tracing, no session replay. Tracing
# burns the free-tier quota fastest, and replay records the DOM of pages
# carrying names and phone numbers — a PDPA question nobody has answered.
#
# Unset, Sentry never initialises and no network calls are made. Errors
# are also suppressed outside production unless SENTRY_DEBUG_LOCAL=true.
#
# The DSN is a write-only ingest key and is expected to be public.

NEXT_PUBLIC_SENTRY_DSN=""

# Server-side fallback, read when NEXT_PUBLIC_SENTRY_DSN is absent. Useful
# if you want server errors reported but no Sentry code in the browser
# bundle at all.
SENTRY_DSN=""

# Source-map upload at build time. Without these, production stack traces
# point at minified bundles and are close to useless — set them in CI.
# The auth token is a secret; never expose it to the browser.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Set to "true" to send events from a local run while testing the
# integration itself. Leave unset otherwise.
SENTRY_DEBUG_LOCAL=""


# ───────────────────────────────────────────────────────────────────────
#  10. CACHE REVALIDATION                                     [optional]
# ───────────────────────────────────────────────────────────────────────
#
# Shared secret for POST /api/revalidate, sent as an X-Revalidate-Secret
# header.
#
# The admin does NOT use this — server actions call revalidatePath
# in-process, which is faster and cannot fail independently. This endpoint
# exists for callers with no session: a CI job after a bulk import, an
# external webhook, or an operator clearing one stale page by hand.
#
# Leave blank and the endpoint returns 501. Generate with:
#   openssl rand -hex 32
REVALIDATE_SECRET=""


# ───────────────────────────────────────────────────────────────────────
#  11. SECURITY HEADERS                                       [optional]
# ───────────────────────────────────────────────────────────────────────
#
# CSP ships as Report-Only. Watch the browser console on production for a
# week or two, correct the allowlist in next.config.js, then set this to
# "true" to start blocking. Enforcing it before the reports are clean
# will silently break GA, the Pixel, reCAPTCHA or the map embed.

CSP_ENFORCE="false"


# ───────────────────────────────────────────────────────────────────────
#  12. EMAIL — SMTP                                            [optional]
# ───────────────────────────────────────────────────────────────────────
#
# lib/email.ts. Without SMTP_HOST, every send is a logged no-op — the site
# runs fine with LINE as the only outbound channel, exactly as before.
#
# Once SMTP_HOST is set, three things start sending:
#   - A staff notification email on every new lead, alongside the LINE push
#   - A staff notification email on every new RSVP, alongside the LINE push
#   - The RSVP confirmation email to the attendee themselves — this is the
#     one the on-site copy already promises ("we will confirm by email"),
#     so it is worth setting these in every environment that takes real
#     RSVPs, staging included.

SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Andaman Asset Solution"
SMTP_FROM_EMAIL="no-reply@andamanassetsolution.com"
LEAD_NOTIFICATION_TO_EMAIL="sales@andamanassetsolution.com"


# ───────────────────────────────────────────────────────────────────────
#  13. END-TO-END TESTS                                        [optional]
# ───────────────────────────────────────────────────────────────────────
#
# Only `npm run test:e2e` reads these. Leave them unset in production.
#
# ⚠ THE E2E DATABASE IS WIPED ON EVERY RUN.
#
#   e2e/global-setup.ts truncates every table before seeding fixtures, and
#   refuses to start if E2E_DATABASE_URL is missing or identical to
#   DATABASE_URL. Give it its own database:
#
#     createdb andaman_e2e
#
# See docs/TESTING.md for the full setup.

E2E_DATABASE_URL="postgresql://andaman_admin:changeme_local_only@localhost:5432/andaman_e2e?schema=public"

# Port for the server Playwright starts. Separate from 3000 so an e2e run
# does not fight the dev server you already have open.
E2E_PORT=3100

# Seeded by global-setup and used by e2e/admin-login.spec.ts. Defaults are
# in e2e/fixtures.ts; override only if you need to.
E2E_ADMIN_EMAIL="e2e-admin@andaman.test"
E2E_ADMIN_PASSWORD="e2e-only-passphrase-1234"

# Set by playwright.config.ts for the server it starts — NOT here.
# Turning this on removes the brute-force limit from the sign-in route.
# RATE_LIMIT_DISABLED=1
