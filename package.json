{
  "name": "andaman-asset-solution",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:db": "tsx e2e/global-setup.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:report": "playwright show-report",
    "verify": "npm run lint && npm run typecheck && npm test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:check": "tsx scripts/db-check.ts",
    "spaces:check": "tsx scripts/spaces-check.ts",
    "spaces:cors": "tsx scripts/spaces-cors.ts",
    "media:legacy": "tsx scripts/media-legacy-check.ts",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:stop": "brew services stop postgresql@16 2>/dev/null || docker compose down",
    "setup": "bash scripts/setup-db.sh",
    "setup:docker": "bash scripts/setup-db.sh docker",
    "setup:native": "bash scripts/setup-db.sh native",
    "docker:build": "docker build -t andaman-asset-solution .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env andaman-asset-solution"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.0",
    "@next/env": "^15.5.25",
    "@prisma/client": "^5.20.0",
    "@sentry/nextjs": "^10.73.0",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^11.5.4",
    "isomorphic-dompurify": "^2.16.0",
    "lucide-react": "^0.446.0",
    "marked": "^14.1.2",
    "next": "^15.5.25",
    "next-auth": "^4.24.7",
    "next-intl": "^4.14.1",
    "nodemailer": "^9.1.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.53.0",
    "react-zoom-pan-pinch": "^4.0.4",
    "recharts": "^2.12.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  }
}
