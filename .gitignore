*.log
.DS_Store
/prisma/migrations/dev.db*
# tsc --incremental's cache — regenerated by every `tsc` run (including the
# background type-check `next dev` does), so it churns constantly and was
# showing up as a noisy diff in nearly every commit.
tsconfig.tsbuildinfo

# ── Test output ─────────────────────────────────────────────────────────
/coverage
# Copied out of node_modules by scripts/copy-pdfjs-assets.mjs on every
# install and build — 4.4MB of generated bytes that would otherwise land in
# a commit and go stale against the pinned pdfjs-dist.
/public/pdfjs
# Same trade, same reasons, for flag-icons — see copy-flag-assets.mjs.
/public/flags
/playwright-report
/test-results
/blob-report
/playwright/.cache
_to_delete/
_claude_preview*.jpg
_claude_preview*.webp

# Agent scratch directories. .gemini/ once held throwaway S3 probe scripts
# that were committed with a real access key in them; nothing an agent
# leaves lying around belongs in the repository.
.gemini/
.claude/
.aider*
